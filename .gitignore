#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer virtualenv
env/
venv/
ENV/
env.bak/
venv.bak/

# VS Code
.vscode/

# macOS
.DS_Store

# dotenv
.env

# Python cache
__pypackages__/

# PyCharm
.idea/

# Model/task files (keep out of repo if large)
models/*.task

# Other
*.sqlite3
*.db
